{
  "expo": {
    "name": "DevRepo",
    "slug": "devrepo-task-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#080810"
