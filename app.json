      "bundleIdentifier": "com.devrepo.taskmanager"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080810"
      },
      "package": "com.devrepo.taskmanager"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
